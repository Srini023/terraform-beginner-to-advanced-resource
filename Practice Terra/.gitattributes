#All files would be converted to LF ending
* text=auto eol=lf

#Always keep this files as Windows ones
*.cmd eol=crlf
*.bat eol=crlf

# Denote all files that are truly binary and should not be modified.
*.jar binary
*.png binary
*.jpg binary
*.xcf binary
*.gif binary
*.pdf binary
*.xlsx binary
*.docx binary
